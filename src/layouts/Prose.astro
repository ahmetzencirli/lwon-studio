---
import Base from './Base.astro';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  frontmatter?: { title: string; description: string };
}
const { frontmatter, headings = [] } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? '';
const description = Astro.props.description ?? frontmatter?.description ?? '';
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={title} description={description}>
  <div class="container doc" class:list={{ 'has-toc': toc.length > 0 }}>
    {toc.length > 0 && (
      <aside class="toc">
        <details open>
          <summary>On this page</summary>
          <nav aria-label="On this page">
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </nav>
        </details>
      </aside>
    )}
    <article class="prose">
      <slot />
    </article>
  </div>
</Base>

<script>
  // Copy buttons on code blocks.
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'pre-wrap';
    pre.replaceWith(wrap);
    wrap.append(pre);
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1400);
    });
    wrap.append(btn);
  });

  // The contents list is collapsible on narrow screens and always open in the desktop sidebar,
  // whose toggle is hidden, so it follows the viewport when the window is resized.
  const toc = document.querySelector<HTMLDetailsElement>('.toc details');
  const narrow = matchMedia('(max-width: 979px)');
  if (toc) {
    const sync = () => (toc.open = !narrow.matches);
    sync();
    narrow.addEventListener('change', sync);
  }
</script>

<style>
  .doc { padding-top: clamp(32px, 5vw, 56px); padding-bottom: 80px; display: grid; gap: 32px; }
  @media (min-width: 980px) {
    .doc.has-toc { grid-template-columns: 220px minmax(0, 1fr); gap: 56px; }
    .toc { position: sticky; top: 88px; align-self: start; max-height: calc(100vh - 110px); overflow: auto; }
    .toc summary { pointer-events: none; list-style: none; }
    .toc summary::-webkit-details-marker { display: none; }
  }
  .toc summary { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); cursor: pointer; padding: 6px 0; }
  .toc ul { list-style: none; margin: 8px 0 0; padding: 0; border-left: 1px solid var(--border); }
  .toc a { display: block; padding: 5px 0 5px 14px; margin-left: -1px; border-left: 2px solid transparent; color: var(--text-2); text-decoration: none; font-size: 0.88rem; line-height: 1.4; }
  .toc a:hover { color: var(--text); border-left-color: var(--border-strong); }
  @media (max-width: 979px) {
    .toc { border: 1px solid var(--border); border-radius: var(--radius); padding: 8px 14px; background: var(--surface); }
  }
  .prose { min-width: 0; }
  .prose :global(h1) { font-size: clamp(2rem, 4vw, 2.75rem); }
  .prose :global(table) { display: block; overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  .prose :global(.pre-wrap) { position: relative; }
  .prose :global(.copy-btn) {
    position: absolute; top: 8px; right: 8px;
    font: inherit; font-size: 0.75rem; font-weight: 600;
    min-height: 28px; padding: 0 10px; border-radius: 8px;
    border: 1px solid var(--border-strong); background: var(--surface); color: var(--text-2);
    cursor: pointer; opacity: 0; transition: opacity 0.15s;
  }
  .prose :global(.pre-wrap:hover .copy-btn), .prose :global(.copy-btn:focus-visible) { opacity: 1; }
  @media (hover: none) { .prose :global(.copy-btn) { opacity: 1; } }
</style>
